# ===== เว็บแอป =====
PORT=3000
HOST=0.0.0.0

# ที่เก็บข้อมูล (ใช้ path บน NAS/ดิสก์สำรองได้ เช่น /mnt/nas/ekg/uploads หรือ D:\ekg\uploads)
DATA_DIR=data
UPLOAD_DIR=uploads

# ===== ระบบ Login =====
# AUTH_MODE: hosxp = ใช้ HOSxP เท่านั้น | local = ใช้ APP_USER/APP_PASSWORD | both = ลอง HOSxP ก่อน (ค่าเริ่มต้น)
AUTH_MODE=both

# บัญชีสำรอง (local) ใช้เมื่อ AUTH_MODE=local หรือ both — เว้นว่างเพื่อปิดบัญชีสำรอง
APP_USER=staff
APP_PASSWORD=change-me

# Secret สำหรับ Session cookie (สุ่มสตริงยาวๆ ใส่เองหรือจะปล่อยให้ระบบสุ่มก็ได้)
# SESSION_SECRET=ใส่สตริงสุ่มที่นี่
# SESSION_MAX_AGE=28800   # หน่วย: วินาที (28800 = 8 ชั่วโมง)
# HTTPS=true   # เปิดเมื่อใช้ reverse proxy + TLS เพื่อให้ cookie เป็น Secure

# ==============================================================================
# ฐานข้อมูลที่ 1: สำหรับดึงรูปภาพ / สแกน (opdscan, patient_opd_scan, er_image)
# ==============================================================================
HOSXP_DB_HOST=192.168.1.100
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=hosimage          # ชื่อฐานข้อมูลภาพ (เช่น hosimage หรือ hos)
HOSXP_DB_USER=ekg_readonly
HOSXP_DB_PASSWORD=
HOSXP_DB_CHARSET=UTF8MB4_GENERAL_CI  # ถ้าภาษาไทยเป็นตัวอ่านไม่ออก ให้ลองเปลี่ยนเป็น TIS620_THAI_CI

# ความยาว HN ใน HOSxP (ใช้เติม 0 ข้างหน้า เช่น 12345 -> 000012345)
HOSXP_HN_LENGTH=9
# ตารางภาพสแกนของ HOSxP (อ่านอย่างเดียว)
HOSXP_SCAN_TABLE=opdscan
# แหล่งภาพใน HOSxP ที่จะดึงมาแสดง (คั่นด้วย ,)
HOSXP_IMAGE_SOURCES=opdscan,patient_opd_scan,er_image,lab_order_image

# ==============================================================================
# ฐานข้อมูลที่ 2: สำหรับเช็ค User / Password และข้อมูลคนไข้ (sys_user, opduser, patient)
# ==============================================================================
# หากอยู่เซิร์ฟเวอร์เดียวกันกับฐานรูปภาพ ให้ระบุแค่ HOSXP_AUTH_DB_NAME ก็พอ (ส่วน Host/User/Pass จะดึงจากด้านบนอัตโนมัติ)
# หากอยู่คนละ Server / แยกเครื่อง ให้ระบุ IP, User, Password ของฐานนี้ด้วย
HOSXP_AUTH_DB_NAME=hos          # ชื่อฐานข้อมูลหลัก/Auth (เช่น hos)
# HOSXP_AUTH_DB_HOST=192.168.1.100   # ใส่เฉพาะกรณีแยกคนละ IP
# HOSXP_AUTH_DB_PORT=3306
# HOSXP_AUTH_DB_USER=ekg_readonly    # ใส่เฉพาะกรณีแยก User
# HOSXP_AUTH_DB_PASSWORD=
# HOSXP_AUTH_DB_CHARSET=UTF8MB4_GENERAL_CI

# ตารางผู้ใช้ใน HOSxP (ระบบจะค้นจากตารางนี้ก่อน และมี fallback ไปยัง opduser, ovst_staff ให้อัตโนมัติ)
HOSXP_USER_TABLE=sys_user
# รูปแบบ Hash รหัสผ่าน HOSxP:
#   md5md5   = md5(md5(password))  ← ส่วนใหญ่ HOSxP ใช้แบบนี้
#   md5      = md5(password)
#   md5upper = md5(password).toUpperCase()
HOSXP_PASSWORD_HASH=md5md5

# เกณฑ์เดาภาพ EKG อัตโนมัติ (ภาพสีจาก patient_opd_scan / er_image)
EKG_AUTO_RATIO=0.06
EKG_AUTO_TILES=0.35
EKG_AUTO_MIN_RATIO=0.008
